source('R/00_helpers.R')

cols <- c('AntiS IgG_Y1','AntiS IgG_Y2','AntiS IgA_Y1','AntiS IgA_Y2',
          'IC50_Y1','IC50_Y2','Spike+ MBC_Y1','Spike+ MBC_Y2','IFNg_Y1','IFNg_Y2')
dat <- read_main()
stopifnot(all(c('Subject ID','study5_Y2_Events',cols) %in% names(dat)))
for (nm in cols) dat[[nm]] <- to_numeric(dat[[nm]], grepl('IgA',nm))
dat <- dat %>% filter(trimws(as.character(study5_Y2_Events)) == 'No Events')

make_paired_panel <- function(data, y1_col, y2_col, title, y_axis, tag, y_breaks) {
  wide <- data %>% transmute(id=as.character(`Subject ID`),
                             Y1=.data[[y1_col]], Y2=.data[[y2_col]]) %>%
    filter(is.finite(Y1),is.finite(Y2),Y1>0,Y2>0)
  if (anyDuplicated(wide$id)) stop('Duplicate Subject ID in paired cohort')
  if (!nrow(wide)) stop('No valid pairs for ',title)
  pval <- if (nrow(wide)>1) wilcox.test(wide$Y2,wide$Y1,paired=TRUE,exact=FALSE)$p.value else NA_real_
  sig <- if (is.na(pval)) 'NA' else if(pval<.001) '***' else if(pval<.01) '**' else if(pval<.05) '*' else 'ns'
  long <- wide %>% pivot_longer(c(Y1,Y2), names_to='timepoint',values_to='value') %>%
    mutate(timepoint=factor(timepoint,levels=c('Y1','Y2'),labels=c('Year 1','Year 2')))
  summ <- long %>% group_by(timepoint) %>%
    summarise(median=median(value),q1=unname(quantile(value,.25)),
              q3=unname(quantile(value,.75)),.groups='drop')
  ymax <- max(long$value); bracket <- ymax*1.5
  ggplot(long,aes(timepoint,value)) +
    geom_line(aes(group=id),color='grey60',linewidth=.35,alpha=.35) +
    geom_point(color='grey50',size=1.7,alpha=.4) +
    geom_errorbar(data=summ,aes(x=timepoint,ymin=q1,ymax=q3),inherit.aes=FALSE,
                  width=.10,linewidth=.85) +
    geom_line(data=summ,aes(x=timepoint,y=median,group=1),inherit.aes=FALSE,linewidth=1.1) +
    geom_point(data=summ,aes(x=timepoint,y=median),inherit.aes=FALSE,size=3.6) +
    annotate('segment',x=1,xend=2,y=bracket,yend=bracket,linewidth=.55) +
    annotate('segment',x=1,xend=1,y=bracket/1.08,yend=bracket,linewidth=.55) +
    annotate('segment',x=2,xend=2,y=bracket/1.08,yend=bracket,linewidth=.55) +
    annotate('text',x=1.5,y=bracket*1.18,label=sig,
             size=if(sig=='ns') 3.5 else 4.2,
             fontface=if(sig=='ns') 'plain' else 'bold',vjust=0) +
    scale_y_log10(breaks=y_breaks,
                  labels=function(x) format(x,scientific=FALSE,trim=TRUE),
                  expand=expansion(mult=c(.05,.32))) +
    labs(title=title,x=paste0('(n = ',nrow(wide),')'),y=y_axis,tag=tag) +
    theme_classic(base_size=12) +
    theme(plot.title=element_text(face='bold',size=12,margin=margin(b=5)),
          plot.tag=element_text(face='bold',size=13),
          axis.text.x=element_text(size=10,margin=margin(t=5)),
          axis.title.x=element_text(size=9.5,margin=margin(t=5)),
          axis.text.y=element_text(size=10),
          axis.title.y=element_text(size=10.5,margin=margin(r=7)),
          axis.line=element_line(linewidth=.6),axis.ticks=element_line(linewidth=.5),
          plot.margin=margin(18,10,5,5))
}

p1 <- make_paired_panel(dat,'AntiS IgG_Y1','AntiS IgG_Y2','Anti-S IgG','U/mL','A',c(10,30,100,300))
p2 <- make_paired_panel(dat,'AntiS IgA_Y1','AntiS IgA_Y2','Anti-S IgA','U/mL','B',c(.1,.3,1,3,10))
p3 <- make_paired_panel(dat,'IC50_Y1','IC50_Y2','Neutralizing antibodies','sVNT50','C',c(30,100,300,1000,3000))
p4 <- make_paired_panel(dat,'Spike+ MBC_Y1','Spike+ MBC_Y2','S-specific memory B cells','% of total B cells','D',c(.01,.03,.1,.3))
p5 <- make_paired_panel(dat,'IFNg_Y1','IFNg_Y2','S-reactive T cell responses','IFN-γ (pg/mL)','E',c(3,10,30,100,300))
figure2 <- (p1|p2|p3)/(p4|p5|patchwork::plot_spacer())
print(figure2)
save_plot(figure2,'Figure2',12,7)
