    n_total = nrow(model_data),
    adjusted_fold_difference = 10^coef_table[terms, "Estimate"],
    ci_lower = 10^ci[terms, 1],
    ci_upper = 10^ci[terms, 2],
    p_value = coef_table[terms, "Pr(>|t|)"]
  )
  list(results = results, counts = counts)
}

ancova_runs <- c(
  lapply(seq_len(nrow(biomarkers)), function(i) {
    run_ancova(dat, biomarkers[i, ], 1, 2, "event_y2")
  }),
  lapply(seq_len(nrow(biomarkers)), function(i) {
    run_ancova(dat, biomarkers[i, ], 2, 3, "event_y3")
  })
)
ancova_results <- dplyr::bind_rows(lapply(ancova_runs, `[[`, "results"))
ancova_counts <- dplyr::bind_rows(lapply(ancova_runs, `[[`, "counts"))
if (!nrow(ancova_results)) stop("No ANCOVA comparisons could be estimated.")
utils::write.csv(ancova_results,
  file.path(table_dir, "Figure3_ANCOVA_Results.csv"), row.names = FALSE)
utils::write.csv(ancova_counts,
  file.path(table_dir, "Figure3_Group_Counts.csv"), row.names = FALSE)
print(ancova_results)

forest_data <- ancova_results |>
  dplyr::mutate(
    biomarker = dplyr::recode(biomarker,
      !!!setNames(as.list(biomarkers$short_label), biomarkers$label)),
    biomarker = factor(biomarker, levels = rev(biomarkers$short_label)),
    comparison = factor(comparison,
      levels = c("COVID vs No Events", "Booster vs No Events")),
    stars = dplyr::case_when(p_value < 0.001 ~ "***",
                              p_value < 0.01 ~ "**",
                              p_value < 0.05 ~ "*", TRUE ~ ""),
    star_x = ci_upper * 1.18
  )
comparison_colors <- c(
  "COVID vs No Events" = "#C43C8C",
  "Booster vs No Events" = "#3F7FC4"
)
comparison_shapes <- c("COVID vs No Events" = 16,
                       "Booster vs No Events" = 15)
comparison_labels <- c("COVID vs No Events" = "SARS-CoV-2 infection",
                       "Booster vs No Events" = "Booster vaccination")

# Shared x limits accommodate all confidence intervals and significance stars.
x_values <- c(forest_data$ci_lower, forest_data$ci_upper,
              forest_data$star_x)
x_limits <- range(c(1, x_values[is.finite(x_values) & x_values > 0]))
x_limits <- x_limits * c(0.85, 1.2)

make_forest <- function(data, period, tag, show_y = TRUE) {
  dodge <- ggplot2::position_dodge(width = 0.45)
  p <- ggplot2::ggplot(dplyr::filter(data, .data$period == period),
    ggplot2::aes(x = adjusted_fold_difference, y = biomarker,
                 shape = comparison, color = comparison, group = comparison)) +
    ggplot2::geom_vline(xintercept = 1, linetype = "dashed",
                        color = "grey55", linewidth = 0.6) +
    ggplot2::geom_errorbar(ggplot2::aes(xmin = ci_lower, xmax = ci_upper),
                           orientation = "y", position = dodge,
                           width = 0, linewidth = 0.85) +
    ggplot2::geom_point(position = dodge, size = 3.2) +
    ggplot2::geom_text(ggplot2::aes(x = star_x, label = stars),
                       position = dodge, size = 4.5,
                       fontface = "bold", show.legend = FALSE) +
    ggplot2::scale_x_log10() +
    ggplot2::coord_cartesian(xlim = x_limits) +
    ggplot2::scale_color_manual(values = comparison_colors,
                                labels = comparison_labels) +
    ggplot2::scale_shape_manual(values = comparison_shapes,
                                labels = comparison_labels) +
    ggplot2::labs(tag = tag, x = paste0(
      "Adjusted fold difference compared with children\n",
      "who experienced no events (95% CI)"),
      y = NULL, color = NULL, shape = NULL) +
    ggplot2::theme_classic(base_size = 12) +
    ggplot2::theme(
      plot.tag = ggplot2::element_text(face = "bold", size = 14),
      axis.title.x = ggplot2::element_text(size = 9.5),
      axis.text.x = ggplot2::element_text(size = 9.5),
      axis.text.y = ggplot2::element_text(size = 10.5),
      panel.grid.major.y = ggplot2::element_line(color = "grey92"),
      plot.margin = ggplot2::margin(10, 15, 12, 10))
  if (!show_y) p <- p + ggplot2::theme(
    axis.text.y = ggplot2::element_blank(),
    axis.ticks.y = ggplot2::element_blank())
  p
}
figure3 <- (make_forest(forest_data, "Y1-Y2", "A") |
            make_forest(forest_data, "Y2-Y3", "B", FALSE)) +
           patchwork::plot_layout(guides = "collect") &
           ggplot2::theme(legend.position = "right")
print(figure3)
