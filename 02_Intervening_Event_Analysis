cat("\nY2-Y3 event groups:\n")
print(table(dat$event_y3, useNA = "ifany"))


# ============================================================
# 5. FUNCTION: ANCOVA
# ============================================================

run_ancova <- function(
    data,
    biomarker,
    label,
    previous_year,
    subsequent_year,
    event_col
) {

  # ----------------------------------------------------------
  # Prepare model data
  # ----------------------------------------------------------

  df <- data %>%
    transmute(
      previous = .data[[
        paste0(biomarker, "_y", previous_year)
      ]],

      subsequent = .data[[
        paste0(biomarker, "_y", subsequent_year)
      ]],

      event = .data[[event_col]]
    ) %>%
    filter(
      !is.na(previous),
      !is.na(subsequent),
      previous > 0,
      subsequent > 0,
      !is.na(event)
    ) %>%
    mutate(
      event = factor(
        event,
        levels = c(
          "No Events",
          "COVID",
          "Booster"
        )
      ),

      log_previous = log10(previous),
      log_subsequent = log10(subsequent)
    )

  # ----------------------------------------------------------
  # Sample sizes
  # ----------------------------------------------------------

  counts <- as.data.frame(
    table(df$event)
  )

  names(counts) <- c("Event", "n")
  counts$Biomarker <- label
  counts$Period <- paste0(
    "Y", previous_year,
    "-Y", subsequent_year
  )

  # ----------------------------------------------------------
  # Check available event groups
  # ----------------------------------------------------------

  df$event <- droplevels(df$event)

  if (
    !("No Events" %in% levels(df$event)) ||
    nlevels(df$event) < 2
  ) {
    warning("Insufficient groups for ", label)

    return(list(
      results = NULL,
      counts = counts
    ))
  }

  # ----------------------------------------------------------
  # ANCOVA model
  # ----------------------------------------------------------

  model <- lm(
    log_subsequent ~ log_previous + event,
    data = df
  )

  coef_table <- summary(model)$coefficients
  ci <- confint(model)

  # Extract infection and booster coefficients
  terms <- grep(
    "^event",
    rownames(coef_table),
    value = TRUE
  )

  # ----------------------------------------------------------
  # Adjusted fold differences
  # ----------------------------------------------------------

  results <- data.frame(
    Period = paste0(
      "Y", previous_year,
      "-Y", subsequent_year
    ),

    Biomarker = label,

    Comparison = case_when(
      terms == "eventCOVID" ~ "COVID vs No Events",
      terms == "eventBooster" ~ "Booster vs No Events",
      TRUE ~ terms
    ),

    n = nrow(df),

    Fold_Difference =
      10^coef_table[terms, "Estimate"],

    CI_Lower =
      10^ci[terms, 1],

    CI_Upper =
      10^ci[terms, 2],

    p_value =
      coef_table[terms, "Pr(>|t|)"],

    row.names = NULL
  )

  list(
    results = results,
    counts = counts
  )
}


# ============================================================
# 6. RUN ANCOVA FOR ALL BIOMARKERS
# ============================================================

results_list <- list()
counts_list <- list()

for (i in seq_along(biomarkers)) {

  # Year 1 -> Year 2
  y2 <- run_ancova(
    dat,
    biomarkers[i],
    biomarker_labels[i],
    1, 2,
    "event_y2"
  )

  # Year 2 -> Year 3
  y3 <- run_ancova(
    dat,
    biomarkers[i],
    biomarker_labels[i],
    2, 3,
    "event_y3"
  )

  results_list <- c(
    results_list,
    list(y2$results, y3$results)
  )

  counts_list <- c(
    counts_list,
    list(y2$counts, y3$counts)
  )
}

ancova_results <- bind_rows(results_list)
ancova_counts <- bind_rows(counts_list)

cat("\n========================================\n")
cat("ANCOVA RESULTS\n")
cat("========================================\n")

print(ancova_results)


# ============================================================
