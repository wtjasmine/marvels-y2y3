biomarkers <- c(
  "anti_s_ig_g",
  "anti_s_ig_a",
  "ic50",
  "spike_mbc",
  "if_ng"
)

biomarker_labels <- c(
  "Anti-S IgG",
  "Anti-S IgA",
  "nAbs",
  "S+ MBC",
  "S-reactive T cell responses"
)

# Convert biomarker values to numeric
for (b in biomarkers) {

  for (year in 1:3) {

    col <- paste0(b, "_y", year)

    x <- trimws(as.character(dat[[col]]))

    if (b == "anti_s_ig_a") {
      x[x == "Negative"] <- "0.1"
    }

    dat[[col]] <- suppressWarnings(as.numeric(x))
  }
}


# ============================================================
# 4. CLASSIFY INTERVENING EVENTS
# ============================================================

# No Events: No infection or booster
# COVID: SARS-CoV-2 infection only
# Booster: Booster vaccination only
#
# Exclude combined infection + booster events.

clean_event <- function(x) {

  x <- tolower(trimws(as.character(x)))

  case_when(
    x %in% c("no events", "no event", "none") ~ "No Events",
    grepl("boost", x) & grepl("covid", x) ~ NA_character_,
    grepl("boost", x) ~ "Booster",
    grepl("covid", x) ~ "COVID",
    TRUE ~ NA_character_
  )
}

dat <- dat %>%
  mutate(
    event_y2 = clean_event(study5_y2_events),
    event_y3 = clean_event(study5_y3_events)
  )

cat("\nY1-Y2 event groups:\n")
