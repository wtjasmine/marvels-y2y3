# ============================================================
# 8. PREPARE FOREST PLOT DATA
# ============================================================

plot_data <- ancova_results %>%
  mutate(
    Biomarker = factor(
      Biomarker,
      levels = rev(biomarker_labels)
    ),

    Comparison = factor(
      Comparison,
      levels = c(
        "COVID vs No Events",
        "Booster vs No Events"
      )
    ),

    significance = case_when(
      p_value < 0.001 ~ "***",
      p_value < 0.01 ~ "**",
      p_value < 0.05 ~ "*",
      TRUE ~ ""
    ),

    star_x = CI_Upper * 1.25
  )


# ============================================================
# 9. PLOT SETTINGS
# ============================================================

event_colors <- c(
  "COVID vs No Events" = "#C43C8C",
  "Booster vs No Events" = "#3F7FC4"
)

event_shapes <- c(
  "COVID vs No Events" = 16,
  "Booster vs No Events" = 15
)

event_labels <- c(
  "COVID vs No Events" = "SARS-CoV-2 infection",
  "Booster vs No Events" = "Booster vaccination"
)

pd <- position_dodge(width = 0.45)

x_axis_title <- paste0(
  "Adjusted fold difference compared to children\n",
  "who experienced no events (95% CI)"
)

# Shared x-axis range for both panels
x_values <- c(
  plot_data$CI_Lower,
  plot_data$CI_Upper,
  plot_data$star_x,
  1
)

x_limits <- range(x_values, na.rm = TRUE) *
  c(0.85, 1.20)


# ============================================================
# 10. FUNCTION: FOREST PLOT
# ============================================================

make_forest_plot <- function(
    data,
    period,
    panel,
    show_y = TRUE
) {

  df <- data %>%
    filter(Period == period)

  p <- ggplot(
    df,
    aes(
      x = Fold_Difference,
      y = Biomarker,
      color = Comparison,
      shape = Comparison,
      group = Comparison
    )
  ) +

    # Reference line
    geom_vline(
      xintercept = 1,
      linetype = "dashed",
      color = "grey55",
      linewidth = 0.6
    ) +

    # Confidence intervals
    geom_errorbar(
      aes(
        xmin = CI_Lower,
        xmax = CI_Upper
      ),
      orientation = "y",
      position = pd,
      width = 0,
      linewidth = 0.85
    ) +

    # Fold differences
    geom_point(
      position = pd,
      size = 3.2
    ) +

    # Significance stars
    geom_text(
      aes(
        x = star_x,
        label = significance
      ),
      position = pd,
      size = 4.5,
      fontface = "bold",
      show.legend = FALSE
    ) +

    scale_x_log10() +

    coord_cartesian(
      xlim = x_limits
    ) +

    scale_color_manual(
      values = event_colors,
      labels = event_labels
    ) +

    scale_shape_manual(
      values = event_shapes,
      labels = event_labels
    ) +

    labs(
      tag = panel,
      x = x_axis_title,
      y = NULL,
      color = NULL,
      shape = NULL
    ) +

    theme_classic(base_size = 12) +

    theme(
      plot.tag = element_text(
        face = "bold",
        size = 14
      ),

      axis.text.y = element_text(size = 10.5),
      axis.text.x = element_text(size = 9.5),

      axis.title.x = element_text(
        size = 9.5,
        lineheight = 1.05,
        margin = margin(t = 8)
      ),

      panel.grid.major.y = element_line(
        color = "grey92",
        linewidth = 0.35
      ),

      panel.grid.major.x = element_blank(),
      panel.grid.minor = element_blank(),

      legend.position = "right",
      legend.text = element_text(size = 10),

      plot.margin = margin(10, 15, 12, 10)
    )

  if (!show_y) {
    p <- p +
      theme(
        axis.text.y = element_blank(),
        axis.ticks.y = element_blank()
      )
  }

  return(p)
}


