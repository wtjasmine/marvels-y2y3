source('R/00_helpers.R')
dat <- read_main() %>% mutate(event_Y2=clean_event(study5_Y2_Events),
                            event_Y3=clean_event(study5_Y3_Events))
biomarkers <- tibble::tibble(
  name=c('Anti-S IgG','Anti-S IgA','Neutralization IC50','Spike+ MBC','IFN-γ'),
  root=c('AntiS IgG','AntiS IgA','IC50','Spike+ MBC','IFNg'))

run_ancova <- function(data, marker, root, prior, current, event_col) {
  before <- paste0(root,'_',prior); after <- paste0(root,'_',current)
  d <- data %>% transmute(previous=to_numeric(.data[[before]],grepl('IgA',root)),
                          subsequent=to_numeric(.data[[after]],grepl('IgA',root)),
                          event=.data[[event_col]]) %>%
    filter(is.finite(previous),is.finite(subsequent),previous>0,subsequent>0,!is.na(event)) %>%
    mutate(event=factor(event,levels=c('No Events','COVID','Booster')))
  cat('\n', prior,'->',current,marker,'\n');print(table(d$event))
  d$event <- droplevels(d$event)
  if (!('No Events' %in% levels(d$event)) || nlevels(d$event)<2)
    stop('Insufficient event groups for ',marker,' ',prior,' -> ',current)
  d$event <- relevel(d$event,ref='No Events')
  fit <- lm(log10(subsequent) ~ log10(previous) + event,data=d)
  tab <- summary(fit)$coefficients; cis <- confint(fit)
  terms <- grep('^event',rownames(tab),value=TRUE)
  tibble::tibble(biomarker=marker,
                 comparison=ifelse(terms=='eventCOVID','COVID vs No Events','Booster vs No Events'),
                 adjusted_fold_difference=10^tab[terms,'Estimate'],
                 fold_CI_low=10^cis[terms,1],fold_CI_high=10^cis[terms,2],
                 p.value=tab[terms,'Pr(>|t|)'],n=nrow(d))
}

run_year <- function(prior,current,event_col) {
  dplyr::bind_rows(lapply(seq_len(nrow(biomarkers)),function(i)
    run_ancova(dat,biomarkers$name[i],biomarkers$root[i],prior,current,event_col)))
}
y2 <- run_year('Y1','Y2','event_Y2')
y3 <- run_year('Y2','Y3','event_Y3')
write.csv(y2,file.path(table_dir,'Figure3_ANCOVA_Y1_Y2.csv'),row.names=FALSE)
write.csv(y3,file.path(table_dir,'Figure3_ANCOVA_Y2_Y3.csv'),row.names=FALSE)
print(y2);print(y3)

pretty_names <- c('Anti-S IgG'='Anti-S IgG','Anti-S IgA'='Anti-S IgA',
                  'Neutralization IC50'='nAbs','Spike+ MBC'='S+ MBC',
                  'IFN-γ'='S-reactive T cell responses')
plot_levels <- rev(unname(pretty_names))
comparison_levels <- c('COVID vs No Events','Booster vs No Events')
plot_data <- function(x) x %>% mutate(
  biomarker=factor(unname(pretty_names[biomarker]),levels=plot_levels),
  comparison=factor(comparison,levels=comparison_levels),
  stars=case_when(p.value<.001~'***',p.value<.01~'**',p.value<.05~'*',TRUE~''),
  star_x=fold_CI_high*1.25)
colors <- c('COVID vs No Events'='#C43C8C','Booster vs No Events'='#3F7FC4')
shapes <- c('COVID vs No Events'=16,'Booster vs No Events'=15)
legend_labels <- c('Booster vs No Events'='Booster vaccination',
                   'COVID vs No Events'='SARS-CoV-2 infection')
pd <- position_dodge(width=.45)
axis_title <- 'Adjusted fold difference compared to children\nwho experienced no events (95% CI)'

make_forest <- function(x,tag,hide_y=FALSE) {
  g <- ggplot(plot_data(x),aes(x=adjusted_fold_difference,y=biomarker,
                           color=comparison,shape=comparison,group=comparison)) +
    geom_vline(xintercept=1,linetype='dashed',linewidth=.6,color='grey55') +
    geom_errorbar(aes(xmin=fold_CI_low,xmax=fold_CI_high),orientation='y',
                  position=pd,width=0,linewidth=.85) +
    geom_point(position=pd,size=3.2) +
    geom_text(aes(x=star_x,label=stars),position=pd,size=4.5,
              fontface='bold',show.legend=FALSE) +
    scale_x_log10(breaks=c(.125,.5,1,2,8,32),labels=c('0.125','0.5','1','2','8','32')) +
    coord_cartesian(xlim=c(.125,32)) +
    scale_color_manual(values=colors,breaks=names(legend_labels),labels=legend_labels) +
    scale_shape_manual(values=shapes,breaks=names(legend_labels),labels=legend_labels) +
    labs(title=tag,x=axis_title,y=NULL,color=NULL,shape=NULL) +
    theme_classic(base_size=12) +
    theme(plot.title=element_text(face='bold',size=14),axis.text.y=element_text(size=10.5),
          axis.text.x=element_text(size=9.5),
          axis.title.x=element_text(size=9.5,lineheight=1.05,hjust=.5,margin=margin(t=8)),
          legend.text=element_text(size=10),
          panel.grid.major.y=element_line(color='grey92',linewidth=.35),
          plot.margin=margin(10,15,12,10))
  if (hide_y) g <- g+theme(axis.text.y=element_blank(),axis.ticks.y=element_blank())
  g
}
figure3 <- (make_forest(y2,'A') | make_forest(y3,'B',TRUE)) +
  patchwork::plot_layout(widths=c(1,1),guides='collect') & theme(legend.position='right')
print(figure3)
