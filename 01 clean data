# ============================================================
# 01_clean_data.R
# Read the raw Excel file, clean biomarkers and event groups,
# and save one cleaned dataset used by all later scripts.
#
# Output: data/processed/dat_clean.rds
# ============================================================

source(here::here("R", "00_setup.R"))


# ---- 1. Read raw data -----------------------------------------
raw <- read_excel(file_main)


# ---- 2. Select and rename columns ------------------------------
# Named vector: new_name = "original column name"
rename_map <- c(
  subject_id   = "Subject ID",
  event_y2_raw = "study5_Y2_Events",
  event_y3_raw = "study5_Y3_Events"
)

for (i in seq_len(nrow(biomarker_info))) {
  for (yr in 1:3) {
    new_name <- bm_col(biomarker_info$key[i], yr)
    rename_map[new_name] <- paste0(biomarker_info$raw_prefix[i], "_Y", yr)
  }
}

dat <- raw %>%
  select(all_of(rename_map)) %>%
  mutate(subject_id = as.character(subject_id))

stopifnot(!anyDuplicated(dat$subject_id))


# ---- 3. Clean biomarkers ---------------------------------------
# Values reported as "Negative" are set to 0.1 (all biomarkers,
# all years). Any other non-numeric entry becomes NA and is reported.
clean_biomarker <- function(x, name) {
  if (is.numeric(x)) return(x)
  x <- trimws(as.character(x))
  x[x %in% "Negative"] <- "0.1"
  out <- suppressWarnings(as.numeric(x))
  bad <- unique(x[is.na(out) & !is.na(x)])
  if (length(bad) > 0) {
    message(name, ": non-numeric values set to NA: ",
            paste(bad, collapse = ", "))
  }
  out
}

bm_cols <- as.vector(outer(biomarker_info$key, 1:3, bm_col))

for (col in bm_cols) {
  dat[[col]] <- clean_biomarker(dat[[col]], col)
}


# ---- 4. Clean event groups --------------------------------------
# Kept:     "No Events", "COVID" (SARS-CoV-2 infection only),
#           "Booster" (booster only)
# Excluded: booster + infection, and any other category (-> NA)
clean_event <- function(x) {
  x <- trimws(tolower(as.character(x)))
  case_when(
    x %in% c("no events", "no event", "none")  ~ "No Events",
    grepl("boost", x) &  grepl("covid", x)     ~ NA_character_,
    grepl("boost", x) & !grepl("covid", x)     ~ "Booster",
    grepl("covid", x) & !grepl("boost", x)     ~ "COVID",
    TRUE                                       ~ NA_character_
  )
}

dat <- dat %>%
  mutate(
    event_y2 = clean_event(event_y2_raw),
    event_y3 = clean_event(event_y3_raw)
  )


# ---- 5. Checks ----------------------------------------------------
cat("\nY1 -> Y2 events: raw vs cleaned\n")
print(table(dat$event_y2_raw, dat$event_y2, useNA = "ifany"))

cat("\nY2 -> Y3 events: raw vs cleaned\n")
print(table(dat$event_y3_raw, dat$event_y3, useNA = "ifany"))

cat("\nParticipants:", nrow(dat), "\n")


# ---- 6. Save --------------------------------------------------------
saveRDS(dat, file.path(dir_processed, "dat_clean.rds"))
