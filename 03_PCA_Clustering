
# ============================================================
# MARVELS: PCA AND HIERARCHICAL CLUSTERING
# FIGURE 4 AND SUPPLEMENTARY FIGURES
# ============================================================

# ============================================================
# 1. PACKAGES
# ============================================================

library(readxl)
library(dplyr)
library(tidyr)
library(ggplot2)
library(patchwork)
library(janitor)
library(stringr)
library(plot3D)


# ============================================================
# 2. FILE PATHS
# ============================================================

input_file <- "data/MARVELS_longevity_immuno.xlsx"
history_file <- "data/Patient_Immunity_at_1Y.xlsx"

output_dir <- "output"
dir.create(output_dir, showWarnings = FALSE, recursive = TRUE)

set.seed(123)


# ============================================================
# 3. CLUSTER COLORS AND BIOMARKERS
# ============================================================

cluster_colors <- c(
  "Cluster 1" = "#C76D5C",
  "Cluster 2" = "#6A9F58",
  "Cluster 3" = "#5B7FA3"
)

biomarkers <- c(
  "anti_s_ig_g_y1",
  "anti_s_ig_a_y1",
  "ic50_y1",
  "spike_mbc_y1",
  "if_ng_y1"
)

biomarker_labels <- c(
  "Anti-S IgG",
  "Anti-S IgA",
  "nAbs",
  "S+ MBC",
  "S-reactive T cell responses"
)


# ============================================================
# 4. READ AND CLEAN DATA
# ============================================================

dat <- read_excel(input_file) %>%
  clean_names()

# Convert biomarkers to numeric
for (b in biomarkers) {

  x <- trimws(as.character(dat[[b]]))

  if (b == "anti_s_ig_a_y1") {
    x[x == "Negative"] <- "0.1"
  }

  dat[[b]] <- suppressWarnings(as.numeric(x))
}

dat <- dat %>%
  mutate(
    subject_id = as.character(subject_id),
    study5_y2_events =
      trimws(as.character(study5_y2_events))
  )

if (anyDuplicated(dat$subject_id)) {
  stop("Duplicate subject IDs detected.")
}


# ============================================================
# 5. SELECT ANALYSIS COHORT
# ============================================================

# Retain children with:
# - COVID or No Events between Y1 and Y2
# - Complete positive Y1 biomarkers
#
# This follows the original analysis.

dat_y1 <- dat %>%
  filter(
    study5_y2_events %in% c("COVID", "No Events")
  ) %>%
  filter(
    if_all(
      all_of(biomarkers),
      ~ !is.na(.x) & is.finite(.x) & .x > 0
    )
  ) %>%
  select(
    subject_id,
    study5_y2_events,
    all_of(biomarkers)
  )

cat("\nAnalysis cohort: N =", nrow(dat_y1), "\n")
print(table(dat_y1$study5_y2_events))

if (nrow(dat_y1) < 3) {
  stop("Insufficient observations for clustering.")
}


# ============================================================
# 6. LOG10 TRANSFORMATION AND STANDARDIZATION
# ============================================================

x_raw <- dat_y1 %>%
  select(all_of(biomarkers))

x_log <- log10(x_raw)

# Z-score standardization
x_scaled <- scale(x_log)

if (any(!is.finite(x_scaled))) {
  stop("Non-finite scaled values. Check biomarker variability.")
}


# ============================================================
# 7. PRINCIPAL COMPONENT ANALYSIS
# ============================================================

pca <- prcomp(
  x_scaled,
  center = FALSE,
  scale. = FALSE
)

variance <- 100 * pca$sdev^2 / sum(pca$sdev^2)

pca_variance <- data.frame(
  PC = paste0("PC", seq_along(variance)),
  Variance_percent = variance,
  Cumulative_percent = cumsum(variance)
)

cat("\nPCA explained variance:\n")
print(pca_variance)

cat(
  "\nVariance explained by PC1-PC3:",
  round(sum(variance[1:3]), 2),
  "%\n"
)

# PCA loadings
pca_loadings <- data.frame(
  Biomarker = biomarker_labels,
  pca$rotation,
  row.names = NULL
)

print(pca_loadings)

write.csv(
  pca_variance,
  file.path(output_dir, "PCA_Variance.csv"),
  row.names = FALSE
)

write.csv(
  pca_loadings,
  file.path(output_dir, "PCA_Loadings.csv"),
  row.names = FALSE
)


# ============================================================
# 8. HIERARCHICAL CLUSTERING
# ============================================================

# Retain PC1, PC2 and PC3
pc123 <- pca$x[, 1:3, drop = FALSE]

# Euclidean distance + Ward.D2
hc <- hclust(
  dist(pc123),
  method = "ward.D2"
)

# Three clusters
cluster_raw <- cutree(hc, k = 3)

cat("\nRaw cluster sizes:\n")
print(table(cluster_raw))


# ============================================================
# 9. CHARACTERIZE AND LABEL CLUSTERS
# ============================================================

# Cluster 1: Lowest humoral response
# Cluster 2: Relatively IFN-gamma-associated
# Cluster 3: Remaining broad high-response cluster
#
# Labels follow the original analysis.

cluster_profile <- as.data.frame(x_scaled) %>%
  mutate(cluster_raw = cluster_raw) %>%
  group_by(cluster_raw) %>%
  summarise(
    across(all_of(biomarkers), mean),
    .groups = "drop"
  ) %>%
  mutate(
    humoral_mean = rowMeans(
      pick(
        anti_s_ig_g_y1,
        anti_s_ig_a_y1,
        ic50_y1,
        spike_mbc_y1
      )
    ),
    cellular_relative = if_ng_y1 - humoral_mean
  )

# Lowest humoral response
raw_low <- cluster_profile %>%
  arrange(humoral_mean) %>%
  slice(1) %>%
  pull(cluster_raw)

# Highest relative cellular response among remaining
raw_cellular <- cluster_profile %>%
  filter(cluster_raw != raw_low) %>%
  arrange(desc(cellular_relative)) %>%
  slice(1) %>%
  pull(cluster_raw)

# Remaining cluster
raw_high <- setdiff(
  unique(cluster_raw),
  c(raw_low, raw_cellular)
)

# Map raw IDs to final names
cluster_map <- setNames(
  c("Cluster 1", "Cluster 2", "Cluster 3"),
  as.character(c(raw_low, raw_cellular, raw_high))
)

dat_y1$cluster_raw <- cluster_raw

dat_y1$cluster <- factor(
  unname(cluster_map[as.character(cluster_raw)]),
  levels = names(cluster_colors)
)

cat("\nFinal cluster sizes:\n")
print(table(dat_y1$cluster))

write.csv(
  cluster_profile,
  file.path(output_dir, "Cluster_Profiles.csv"),
  row.names = FALSE
)


# ============================================================
# 10. STANDARDIZED IMMUNE PROFILES
# ============================================================

profile_long <- as.data.frame(x_scaled) %>%
  mutate(
    cluster = dat_y1$cluster
  ) %>%
  pivot_longer(
    cols = all_of(biomarkers),
    names_to = "biomarker",
    values_to = "z_value"
  ) %>%
  mutate(
    biomarker = factor(
      biomarker,
      levels = biomarkers,
      labels = biomarker_labels
    )
  )

profile_means <- profile_long %>%
  group_by(cluster, biomarker) %>%
  summarise(
    mean_z = mean(z_value),
    .groups = "drop"
  )

write.csv(
  profile_means,
  file.path(output_dir, "Standardized_Cluster_Means.csv"),
  row.names = FALSE
)


# ============================================================
# 11. FIGURE 4A: STANDARDIZED IMMUNE PROFILES
# ============================================================

p_profile <- ggplot() +

  geom_hline(
    yintercept = 0,
