# ============================================================
# 22. SUPPLEMENTARY FIGURE S4: PRIOR INFECTION HISTORY
# ============================================================

# Requires the separate Year 1 infection-history dataset.

if (file.exists(history_file)) {

  # ----------------------------------------------------------
  # Read history data
  # ----------------------------------------------------------

  history <- read_excel(history_file) %>%
    clean_names() %>%
    select(subject_id, patient_status_1y) %>%
    mutate(
      subject_id = as.character(subject_id),
      patient_status_1y =
        trimws(as.character(patient_status_1y))
    )

  if (anyDuplicated(history$subject_id)) {
    stop("Duplicate subject IDs in infection-history data.")
  }

  # ----------------------------------------------------------
  # Count prior infection episodes
  # ----------------------------------------------------------

  # A = asymptomatic infection
  # S = symptomatic infection
  # V = vaccination

  history <- history %>%
    mutate(
      n_asymptomatic = str_count(patient_status_1y, "A"),
      n_symptomatic = str_count(patient_status_1y, "S")
    )

  # ----------------------------------------------------------
  # Classify prior infection history
  # ----------------------------------------------------------

  history_levels <- c(
    "Vaccination only",
    "1 asymptomatic infection",
    "≥2 asymptomatic infections",
    "1 symptomatic infection",
    "≥2 symptomatic infections",
    "Both asymptomatic + symptomatic infections"
  )

  history <- history %>%
    mutate(
      infection_history = case_when(
        is.na(patient_status_1y) ~ NA_character_,

        n_asymptomatic == 0 & n_symptomatic == 0 ~
          "Vaccination only",

        n_asymptomatic == 1 & n_symptomatic == 0 ~
          "1 asymptomatic infection",

        n_asymptomatic >= 2 & n_symptomatic == 0 ~
          "≥2 asymptomatic infections",

        n_asymptomatic == 0 & n_symptomatic == 1 ~
          "1 symptomatic infection",

        n_asymptomatic == 0 & n_symptomatic >= 2 ~
          "≥2 symptomatic infections",

        n_asymptomatic >= 1 & n_symptomatic >= 1 ~
          "Both asymptomatic + symptomatic infections"
      ),

      infection_history = factor(
        infection_history,
        levels = history_levels
      )
    )

  # ----------------------------------------------------------
  # Merge with cluster assignments
  # ----------------------------------------------------------

  history_data <- dat_y1 %>%
    select(subject_id, cluster) %>%
    left_join(
      history %>%
        select(subject_id, infection_history),
      by = "subject_id"
    )

  cat("\nPrior infection history by cluster:\n")

  print(
    table(
      history_data$cluster,
      history_data$infection_history,
      useNA = "ifany"
    )
  )

  # ----------------------------------------------------------
  # Calculate percentages within each cluster
  # ----------------------------------------------------------

  history_summary <- history_data %>%
    filter(!is.na(infection_history)) %>%
    count(
      cluster,
      infection_history,
      .drop = FALSE
    ) %>%
    group_by(cluster) %>%
    mutate(
      total = sum(n),
      percent = ifelse(total > 0, 100 * n / total, 0)
    ) %>%
    ungroup()

  write.csv(
    history_summary,
    file.path(output_dir, "Y1_Infection_History.csv"),
    row.names = FALSE
  )

  # ----------------------------------------------------------
  # Infection-history colors
  # ----------------------------------------------------------

  history_colors <- c(
    "Vaccination only" = "#D9E6EA",
    "1 asymptomatic infection" = "#A8D1CF",
    "≥2 asymptomatic infections" = "#5FA8A5",
    "1 symptomatic infection" = "#D9B8D5",
    "≥2 symptomatic infections" = "#A66AA2",
    "Both asymptomatic + symptomatic infections" = "#6E557A"
  )

  # ----------------------------------------------------------
  # Figure S4: Stacked bar chart
  # ----------------------------------------------------------

  p_history <- ggplot(
    history_summary,
    aes(
      x = cluster,
      y = percent,
      fill = infection_history
    )
  ) +

    geom_col(
      width = 0.64,
      color = "white",
      linewidth = 0.8
    ) +

    geom_text(
      aes(
        label = ifelse(
          percent >= 5,
          sprintf("%.1f%%", percent),
          ""
        )
      ),
      position = position_stack(vjust = 0.5),
      size = 3.5
    ) +

    scale_fill_manual(
      values = history_colors,
      drop = FALSE
    ) +

    scale_y_continuous(
      limits = c(0, 100),
      breaks = seq(0, 100, 20),
      labels = function(x) paste0(x, "%"),
      expand = expansion(mult = c(0, 0))
    ) +

    labs(
      x = NULL,
      y = "Children within cluster (%)",
      fill = "Infection history by Year 1"
    ) +

    theme_classic(base_size = 13) +

    theme(
      axis.text.x = element_text(size = 12),
      legend.position = "right",
      legend.title = element_text(face = "bold")
    )

  print(p_history)

  ggsave(
    file.path(output_dir, "Supplementary_Figure_S4.pdf"),
    p_history,
    width = 11,
    height = 6
  )

  ggsave(
    file.path(output_dir, "Supplementary_Figure_S4.png"),
    p_history,
    width = 11,
    height = 6,
    dpi = 600
  )

  # ----------------------------------------------------------
  # Fisher's exact test
  # ----------------------------------------------------------

  history_table <- table(
    history_data$cluster,
    history_data$infection_history
  )

  # Remove empty rows and columns
  history_table <- history_table[
    rowSums(history_table) > 0,
    colSums(history_table) > 0,
    drop = FALSE
  ]

  if (nrow(history_table) >= 2 &&
      ncol(history_table) >= 2) {

    set.seed(123)

    history_fisher <- fisher.test(
      history_table,
      simulate.p.value = TRUE,
      B = 100000
    )

    cat("\nFisher's test: prior infection history\n")
    print(history_fisher)

    write.csv(
      data.frame(
        p_value = history_fisher$p.value
      ),
      file.path(output_dir, "History_Fisher.csv"),
      row.names = FALSE
    )
  }

