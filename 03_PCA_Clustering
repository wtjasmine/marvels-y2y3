# ------------------------------------------------------------
# B. Two-dimensional PCA projections
# ------------------------------------------------------------

make_pca_plot <- function(x, y) {

  x_id <- as.integer(sub("PC", "", x))
  y_id <- as.integer(sub("PC", "", y))

  ggplot(
    pc_df,
    aes(
      x = .data[[x]],
      y = .data[[y]],
      color = cluster
    )
  ) +

    geom_point(size = 3, alpha = 0.85) +

    scale_color_manual(values = cluster_colors) +

    labs(
      x = paste0(x, " (", round(variance[x_id], 1), "%)"),
      y = paste0(y, " (", round(variance[y_id], 1), "%)"),
      color = NULL
    ) +

    theme_classic(base_size = 12)
}

