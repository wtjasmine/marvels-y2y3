# ============================================================
# 19. FUNCTION: BIOMARKER BOXPLOT
# ============================================================

make_boxplot <- function(
    name,
    y_label,
    panel,
    breaks,
    limits
) {

  ggplot(
    biomarker_long %>% filter(biomarker == name),
    aes(x = cluster, y = value, color = cluster)
  ) +

    geom_boxplot(
      width = 0.55,
      outlier.shape = NA,
      linewidth = 0.75
    ) +

    geom_jitter(
      width = 0.1,
      height = 0,
      size = 2,
      alpha = 0.55
    ) +

    scale_y_log10(breaks = breaks) +

    coord_cartesian(ylim = limits) +

    scale_color_manual(values = cluster_colors) +

    labs(
      tag = panel,
      x = NULL,
      y = y_label
    ) +

    theme_classic(base_size = 12) +

    theme(
      legend.position = "none",
      axis.text.x = element_text(
        angle = 35,
        hjust = 1,
        size = 9.5
      ),
      plot.tag = element_text(
        face = "bold",
        size = 14
      )
    )
}


