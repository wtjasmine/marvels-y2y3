    )
  )


# ============================================================
# 12. SUBSEQUENT SARS-CoV-2 INFECTION
# ============================================================

infection_summary <- dat_y1 %>%
  group_by(cluster) %>%
  summarise(
    total = n(),
    infected = sum(study5_y2_events == "COVID"),
    no_event = sum(study5_y2_events == "No Events"),
    percent = 100 * infected / total,
    .groups = "drop"
  ) %>%
  mutate(
    label = paste0(
      infected, "/", total, "\n",
      sprintf("%.1f%%", percent)
    )
  )

cat("\nSubsequent infection by cluster:\n")
print(infection_summary)

write.csv(
  infection_summary,
  file.path(output_dir, "Infection_by_Cluster.csv"),
  row.names = FALSE
)


# ============================================================
# 13. FISHER'S EXACT TEST
# ============================================================

infection_table <- table(
  dat_y1$cluster,
  dat_y1$study5_y2_events
)

fisher_result <- fisher.test(infection_table)

cat("\nFisher's exact test:\n")
print(fisher_result)

write.csv(
  data.frame(p_value = fisher_result$p.value),
  file.path(output_dir, "Cluster_Infection_Fisher.csv"),
  row.names = FALSE
)


