# 16. SUPPLEMENTARY FIGURE S1: DENDROGRAM
# ============================================================

plot_dendrogram <- function() {

  par(mar = c(4, 5, 1, 1), xpd = NA)

  plot(
    hc,
    labels = FALSE,
    hang = -1,
    main = "",
    xlab = "",
    sub = "",
    ylab = "Ward.D2 linkage height"
  )

  # Raw cluster order from left to right
  ordered_clusters <- cluster_raw[hc$order]
  raw_order <- unique(ordered_clusters)

  # Convert raw cluster IDs to final names
  final_order <- unname(
    cluster_map[as.character(raw_order)]
  )

  # Draw colored cluster rectangles
  rect.hclust(
    hc,
    k = 3,
    border = cluster_colors[final_order]
  )

  # Cluster label positions
  centres <- sapply(
    raw_order,
    function(k) mean(which(ordered_clusters == k))
  )

  # Place labels below the dendrogram
  y_position <- par("usr")[3] -
    0.03 * diff(par("usr")[3:4])

  text(
    x = centres,
    y = y_position,
    labels = final_order,
    col = cluster_colors[final_order],
    font = 2,
    cex = 1.05
  )
}

