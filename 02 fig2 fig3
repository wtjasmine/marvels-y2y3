dat_noevent <- dat %>% filter(event_y2 == "No Events")

make_paired_panel <- function(data, key, title, ylab, tag,
                              y_breaks = NULL) {

  # Paired complete cases with positive values (log scale)
  df <- data %>%
    transmute(
      subject_id,
      Y1 = .data[[bm_col(key, 1)]],
      Y2 = .data[[bm_col(key, 2)]]
    ) %>%
    filter(!is.na(Y1), !is.na(Y2), Y1 > 0, Y2 > 0)

  n_pair <- nrow(df)

  # Paired Wilcoxon signed-rank test
  wt <- wilcox.test(df$Y2, df$Y1, paired = TRUE, exact = FALSE)
  sig <- sig_stars(wt$p.value)

  sig_size     <- ifelse(sig == "ns", 3.5, 4.2)
  sig_fontface <- ifelse(sig == "ns", "plain", "bold")

  df_long <- df %>%
    pivot_longer(c(Y1, Y2), names_to = "timepoint", values_to = "value") %>%
    mutate(timepoint = factor(timepoint, levels = c("Y1", "Y2"),
                              labels = c("Year 1", "Year 2")))

  # Median and IQR
  summary_df <- df_long %>%
    group_by(timepoint) %>%
    summarise(
      median = median(value),
      q1 = quantile(value, 0.25),
      q3 = quantile(value, 0.75),
      .groups = "drop"
    )

  # Significance bracket position (log scale)
  bracket_y     <- max(df_long$value) * 1.50
  bracket_lower <- bracket_y / 1.08
  sig_text_y    <- bracket_y * 1.18

  if (is.null(y_breaks)) y_breaks <- waiver()

  p <- ggplot(df_long, aes(x = timepoint, y = value)) +
    # individual trajectories and points
    geom_line(aes(group = subject_id),
              color = "grey60", linewidth = 0.35, alpha = 0.35) +
    geom_point(color = "grey50", size = 1.7, alpha = 0.40) +
    # median +/- IQR
    geom_errorbar(data = summary_df,
                  aes(x = timepoint, ymin = q1, ymax = q3),
                  inherit.aes = FALSE,
                  width = 0.10, linewidth = 0.85, color = "black") +
    geom_line(data = summary_df,
              aes(x = timepoint, y = median, group = 1),
              inherit.aes = FALSE, linewidth = 1.1, color = "black") +
    geom_point(data = summary_df,
               aes(x = timepoint, y = median),
               inherit.aes = FALSE, size = 3.6, color = "black") +
    # significance bracket
    annotate("segment", x = 1, xend = 2, y = bracket_y, yend = bracket_y,
             linewidth = 0.55) +
    annotate("segment", x = 1, xend = 1, y = bracket_lower, yend = bracket_y,
             linewidth = 0.55) +
    annotate("segment", x = 2, xend = 2, y = bracket_lower, yend = bracket_y,
             linewidth = 0.55) +
    annotate("text", x = 1.5, y = sig_text_y, label = sig,
             size = sig_size, fontface = sig_fontface, vjust = 0) +
    scale_y_log10(
      breaks = y_breaks,
      labels = scales::label_number(drop0trailing = TRUE, big.mark = ""),
      expand = expansion(mult = c(0.05, 0.32))
    ) +
    labs(
      title = title,
      x = paste0("(n = ", n_pair, ")"),
      y = ylab,
      tag = tag
    ) +
    theme_classic(base_size = 12) +
    theme(
      plot.title   = element_text(face = "bold", size = 12,
                                  margin = margin(b = 5)),
      plot.tag     = element_text(face = "bold", size = 13),
      axis.text.x  = element_text(size = 10, margin = margin(t = 5)),
      axis.title.x = element_text(size = 9.5, margin = margin(t = 5)),
      axis.text.y  = element_text(size = 10),
      axis.title.y = element_text(size = 10.5, margin = margin(r = 7)),
      axis.line    = element_line(linewidth = 0.6),
      axis.ticks   = element_line(linewidth = 0.5),
      panel.grid   = element_blank(),
      plot.margin  = margin(t = 18, r = 10, b = 5, l = 5)
    )

  list(
    plot = p,
    stats = data.frame(
      biomarker = title,
      n_pairs   = n_pair,
      median_y1 = summary_df$median[1],
      median_y2 = summary_df$median[2],
      p_value   = wt$p.value
    )
  )
}

