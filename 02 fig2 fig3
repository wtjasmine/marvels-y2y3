# ---- Forest plot function (used for both panels) -----------------
event_shapes <- c("COVID" = 16, "Booster" = 15)
legend_breaks <- c("Booster", "COVID")
legend_labels <- c("Booster vaccination", "SARS-CoV-2 infection")
pd <- position_dodge(width = 0.45)

x_axis_title <- paste0(
  "Adjusted fold difference compared to children\n",
  "who experienced no events (95% CI)"
)

make_forest <- function(res, tag, show_y_labels = TRUE) {

  plot_df <- res %>%
    mutate(
      biomarker = factor(
        biomarker_info$short_label[match(biomarker, biomarker_info$key)],
        levels = rev(biomarker_info$short_label)
      ),
      comparison = factor(comparison, levels = c("COVID", "Booster")),
      stars  = sig_stars(p_value, ns_label = ""),
      star_x = fold_CI_high * 1.25
    )

  p <- ggplot(plot_df,
              aes(x = adjusted_fold_difference, y = biomarker,
                  shape = comparison, color = comparison,
                  group = comparison)) +
    geom_vline(xintercept = 1, linetype = "dashed",
               linewidth = 0.6, color = "grey55") +
    geom_errorbar(aes(xmin = fold_CI_low, xmax = fold_CI_high),
                  orientation = "y", position = pd,
                  width = 0, linewidth = 0.85) +
    geom_point(position = pd, size = 3.2) +
    geom_text(aes(x = star_x, label = stars), position = pd,
              size = 4.5, fontface = "bold", show.legend = FALSE) +
    scale_x_log10(
      breaks = c(0.125, 0.5, 1, 2, 8, 32),
      labels = c("0.125", "0.5", "1", "2", "8", "32")
    ) +
    coord_cartesian(xlim = c(0.125, 32)) +
    scale_shape_manual(values = event_shapes,
                       breaks = legend_breaks, labels = legend_labels) +
    scale_color_manual(values = event_colors,
                       breaks = legend_breaks, labels = legend_labels) +
    labs(title = tag, x = x_axis_title, y = NULL,
         shape = NULL, color = NULL) +
    theme_classic(base_size = 12) +
    theme(
      plot.title   = element_text(face = "bold", size = 14),
      axis.text.y  = element_text(size = 10.5),
      axis.text.x  = element_text(size = 9.5),
      axis.title.x = element_text(size = 9.5, lineheight = 1.05,
                                  hjust = 0.5, margin = margin(t = 8)),
      legend.position = "right",
      legend.text  = element_text(size = 10),
      panel.grid.major.y = element_line(color = "grey92", linewidth = 0.35),
      panel.grid.major.x = element_blank(),
      panel.grid.minor   = element_blank(),
      plot.margin  = margin(10, 15, 12, ifelse(show_y_labels, 10, 5))
    )

  if (!show_y_labels) {
    p <- p + theme(axis.text.y = element_blank(),
                   axis.ticks.y = element_blank())
  }
  p
}

figure3 <- (make_forest(y2_results, "A", show_y_labels = TRUE) |
              make_forest(y3_results, "B", show_y_labels = FALSE)) +
  plot_layout(widths = c(1, 1), guides = "collect") &
  theme(legend.position = "right")

print(figure3)
