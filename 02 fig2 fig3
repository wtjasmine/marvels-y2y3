# ############################################################
# FIGURE 3
# ANCOVA: log10(subsequent) ~ log10(previous) + event
# Reference group = "No Events". Coefficients are back-transformed
# to adjusted fold differences.
# ############################################################

run_ancova <- function(data, key, prev_year, event_col) {

  d <- data %>%
    transmute(
      previous   = .data[[bm_col(key, prev_year)]],
      subsequent = .data[[bm_col(key, prev_year + 1)]],
      event      = .data[[event_col]]
    ) %>%
    filter(!is.na(previous), !is.na(subsequent), !is.na(event),
           previous > 0, subsequent > 0) %>%
    mutate(
      event = droplevels(factor(event,
                                levels = c("No Events", "COVID", "Booster"))),
      log_previous   = log10(previous),
      log_subsequent = log10(subsequent)
    )

  cat("\n", key, "(Y", prev_year, "-> Y", prev_year + 1, ")\n", sep = "")
  print(table(d$event))

  if (levels(d$event)[1] != "No Events" || nlevels(d$event) < 2) {
    warning(key, ": reference group missing or fewer than two groups")
    return(NULL)
  }

  fit  <- lm(log_subsequent ~ log_previous + event, data = d)
  coef <- summary(fit)$coefficients
  ci   <- confint(fit)
  terms <- grep("^event", rownames(coef), value = TRUE)

  data.frame(
    biomarker  = key,
    comparison = sub("^event", "", terms),       # "COVID" / "Booster"
    n_total    = nrow(d),
    adjusted_fold_difference = 10^coef[terms, "Estimate"],
    fold_CI_low  = 10^ci[terms, 1],
    fold_CI_high = 10^ci[terms, 2],
    p_value    = coef[terms, "Pr(>|t|)"],
    row.names  = NULL
  )
}

run_all_biomarkers <- function(prev_year, event_col) {
  bind_rows(lapply(biomarker_info$key, function(k) {
    run_ancova(dat, k, prev_year, event_col)
  }))
}

y2_results <- run_all_biomarkers(prev_year = 1, event_col = "event_y2")
y3_results <- run_all_biomarkers(prev_year = 2, event_col = "event_y3")

