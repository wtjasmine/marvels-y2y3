# Shared configuration, cleaning, and cohort construction.
# Run scripts from the repository root (or use run_all.R).
suppressPackageStartupMessages({
  library(readxl); library(dplyr); library(tidyr); library(ggplot2); library(patchwork)
})

main_file <- file.path('data', 'MARVELS_longevity_immuno.xlsx')
history_file <- file.path('data', 'Patient_Immunity_at_1Y.xlsx')
figure_dir <- file.path('outputs', 'figures')
table_dir <- file.path('outputs', 'tables')
dir.create(figure_dir, showWarnings = FALSE, recursive = TRUE)
dir.create(table_dir, showWarnings = FALSE, recursive = TRUE)

cluster_colors <- c('Cluster 1'='#C76D5C', 'Cluster 2'='#6A9F58', 'Cluster 3'='#5B7FA3')
biomarker_labels <- c(anti_s_ig_g='Anti-S IgG', anti_s_ig_a='Anti-S IgA',
                      ic50='nAbs', spike_mbc='S+ MBC', if_ng='S-reactive T cell responses')

read_main <- function() {
  if (!file.exists(main_file)) stop('Missing ', main_file, '. See data/README.md', call. = FALSE)
  readxl::read_excel(main_file)
}
read_history <- function() {
  if (!file.exists(history_file)) stop('Missing ', history_file, '. See data/README.md', call. = FALSE)
  readxl::read_excel(history_file)
}

# Conversion rule retained from original analysis: IgA recorded as 'Negative' is 0.1.
# This substitution must be justified by the assay quantification/detection threshold.
to_numeric <- function(x, negative_to_point_one = FALSE) {
  s <- trimws(as.character(x))
  if (negative_to_point_one) s[tolower(s) == 'negative'] <- '0.1'
  suppressWarnings(as.numeric(s))
}

save_plot <- function(plot, stem, width, height) {
  ggplot2::ggsave(file.path(figure_dir, paste0(stem, '.pdf')), plot,
                  device = grDevices::cairo_pdf, width=width, height=height)
  ggplot2::ggsave(file.path(figure_dir, paste0(stem, '.png')), plot,
                  width=width, height=height, dpi=600)
}

clean_event <- function(x) {
  x <- trimws(tolower(as.character(x)))
  dplyr::case_when(
    x %in% c('no events', 'no event', 'none') ~ 'No Events',
    grepl('boost', x) & grepl('covid', x) ~ NA_character_,
    grepl('boost', x) ~ 'Booster',
    grepl('covid', x) ~ 'COVID',
    TRUE ~ NA_character_
  )
}

# Reproduce the original Figure 4 clustering cohort and algorithm unchanged.
# Scientific choice to review: outcome-based (Y2 COVID/No Events) restriction BEFORE clustering.
get_cluster_analysis <- function() {
  if (!requireNamespace('janitor', quietly=TRUE)) stop('Install the janitor package')
  d <- janitor::clean_names(read_main())
  biomarkers <- c('anti_s_ig_g_y1', 'anti_s_ig_a_y1', 'ic50_y1',
                  'spike_mbc_y1', 'if_ng_y1')
  needed <- c('subject_id', 'study5_y2_events', biomarkers)
  if (length(missing <- setdiff(needed, names(d))))
    stop('Missing columns: ', paste(missing, collapse=', '))
  d <- d %>%
    mutate(anti_s_ig_a_y1 = to_numeric(anti_s_ig_a_y1, TRUE),
           across(all_of(setdiff(biomarkers, 'anti_s_ig_a_y1')), to_numeric)) %>%
    filter(study5_y2_events %in% c('COVID', 'No Events'),
           if_all(all_of(biomarkers), ~ !is.na(.x) & is.finite(.x) & .x > 0)) %>%
    select(all_of(needed))
  if (anyDuplicated(d$subject_id)) stop('Duplicate subject IDs in clustering cohort.')
  if (nrow(d) < 4) stop('Not enough complete cases for K=3 clustering.')
  names(d)[match(biomarkers,names(d))] <- names(biomarker_labels)
  x_log <- log10(as.matrix(d[, names(biomarker_labels)]))
  if (any(apply(x_log, 2, sd) == 0)) stop('A biomarker has zero variance.')
  x_scaled <- scale(x_log)
  pca <- prcomp(x_scaled, center=FALSE, scale.=FALSE)
  variance_percent <- 100*pca$sdev^2/sum(pca$sdev^2)
  pc123 <- pca$x[,1:3,drop=FALSE]
  hc <- hclust(dist(pc123), method='ward.D2')
  raw_cluster <- cutree(hc,k=3)
  profiles <- as.data.frame(x_scaled) %>%
    mutate(raw_cluster = raw_cluster) %>%
    group_by(raw_cluster) %>%
    summarise(across(all_of(names(biomarker_labels)),mean), .groups='drop') %>%
    mutate(humoral_mean=rowMeans(pick(anti_s_ig_g,anti_s_ig_a,ic50,spike_mbc)),
           cellular_relative=if_ng-humoral_mean)
  raw_low <- profiles$raw_cluster[which.min(profiles$humoral_mean)]
  remaining <- profiles %>% filter(raw_cluster != raw_low)
  raw_cellular <- remaining$raw_cluster[which.max(remaining$cellular_relative)]
  raw_high <- setdiff(unique(raw_cluster),c(raw_low,raw_cellular))
  d <- d %>% mutate(raw_cluster=raw_cluster,
    cluster=case_when(raw_cluster == raw_low ~ 'Cluster 1',
                      raw_cluster == raw_cellular ~ 'Cluster 2',
                      raw_cluster == raw_high ~ 'Cluster 3'),
    cluster=factor(cluster, levels=names(cluster_colors)))
  list(dat=d, x_scaled=x_scaled, pca=pca, variance_percent=variance_percent,
       pc123=pc123, hc=hc, raw_cluster=raw_cluster, profiles=profiles)
}
