# SUPPLEMENTARY FIGURE S3: Year 1 biomarkers by cluster
# ############################################################

biomarker_long <- dat_y1 %>%
  select(subject_id, cluster, all_of(keys)) %>%
  pivot_longer(all_of(keys), names_to = "key", values_to = "value")

make_boxplot <- function(key, ylab, tag, y_breaks, y_limits) {
  ggplot(biomarker_long %>% filter(key == !!key),
         aes(x = cluster, y = value, color = cluster)) +
    geom_boxplot(width = 0.55, outlier.shape = NA, linewidth = 0.75) +
    geom_jitter(width = 0.10, height = 0, size = 2, alpha = 0.55) +
    scale_y_log10(breaks = y_breaks) +
    scale_color_manual(values = cluster_colors) +
    coord_cartesian(ylim = y_limits) +
    labs(tag = tag, x = NULL, y = ylab) +
    theme_classic(base_size = 12) +
    theme(
      legend.position = "none",
      axis.title.y = element_text(size = 11),
      axis.text.y  = element_text(size = 10),
      axis.text.x  = element_text(size = 9.5, angle = 35, hjust = 1),
      plot.margin  = margin(8, 8, 8, 8),
      plot.tag     = element_text(face = "bold", size = 14)
    )
}

supp_boxplots <- (
  make_boxplot("igg",  "U/mL", "A",
               c(1, 3, 10, 30, 100, 300, 1000), c(1, 1000)) |
  make_boxplot("iga",  "U/mL", "B",
               c(0.1, 0.3, 1, 3, 10), c(0.1, 10)) |
  make_boxplot("nab",  "sVNT50", "C",
               c(10, 30, 100, 300, 1000, 3000, 10000), c(10, 10000)) |
  make_boxplot("mbc",  "% of total B cells", "D",
               c(0.01, 0.03, 0.1, 0.3, 1), c(0.01, 1)) |
  make_boxplot("ifng", "IFN-\u03b3 (pg/mL)", "E",
               c(1, 3, 10, 30, 100, 300, 1000), c(1, 1000))
)

print(supp_boxplots)
save_figure(supp_boxplots, "Supplementary_Figure_S3_biomarkers",
            width = 13, height = 4.8)
