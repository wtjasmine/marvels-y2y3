par(mar = c(4.5, 4.5, 2.0, 2.0), mgp = c(2.2, 0.7, 0))
scatter3D(
  x = pc_df$PC1, y = pc_df$PC2, z = pc_df$PC3,
  colvar = NULL,
  col = unname(cluster_colors[as.character(pc_df$cluster)]),
  pch = 19, cex = 1.5,
  xlab = pc_lab(1), ylab = pc_lab(2), zlab = pc_lab(3),
  zlim = c(-2, 3),
  theta = 42, phi = 25,
  ticktype = "detailed", bty = "g",
  main = "", colkey = FALSE
)
dev.off()

p_3d <- ggplot() +
  annotation_custom(
    rasterGrob(readPNG(temp_3d_file),
               width = unit(1, "npc"), height = unit(1, "npc"),
               interpolate = TRUE),
    xmin = -Inf, xmax = Inf, ymin = -Inf, ymax = Inf
  ) +
  coord_cartesian(xlim = c(0, 1), ylim = c(0, 1), expand = FALSE) +
  labs(tag = "A") +
  theme_void() +
  theme(
    plot.tag = element_text(face = "bold", size = 16),
    plot.tag.position = c(0.01, 0.99),
    plot.margin = margin(0, 0, 0, 0)
  )

pca_theme <- theme_classic(base_size = 12) +
  theme(
    axis.title   = element_text(size = 11),
    axis.text    = element_text(size = 10),
    legend.title = element_blank(),
    legend.text  = element_text(size = 10),
    plot.margin  = margin(6, 8, 6, 8)
  )

make_pca_panel <- function(xpc, ypc, tag = NULL) {
  ggplot(pc_df, aes(x = .data[[paste0("PC", xpc)]],
                    y = .data[[paste0("PC", ypc)]],
                    color = cluster)) +
    geom_point(size = 3, alpha = 0.85) +
    scale_color_manual(values = cluster_colors) +
    labs(tag = tag, x = pc_lab(xpc), y = pc_lab(ypc), color = NULL) +
    pca_theme +
    theme(plot.tag = element_text(face = "bold", size = 16),
          plot.tag.position = c(0.01, 0.99))
}

bottom_row <- (make_pca_panel(1, 2, tag = "B") |
                 make_pca_panel(1, 3) |
                 make_pca_panel(2, 3)) +
  plot_layout(guides = "collect") &
  theme(legend.position = "top")

top_row <- (plot_spacer() | p_3d | plot_spacer()) +
  plot_layout(widths = c(0.05, 1, 0.05))

supp_pca <- (top_row / bottom_row) + plot_layout(heights = c(1.55, 1))

print(supp_pca)
save_figure(supp_pca, "Supplementary_Figure_S1_PCA", width = 12, height = 11)
file.remove(temp_3d_file)


# ############################################################
# SUPPLEMENTARY FIGURE S2: dendrogram (K = 3)
# ############################################################

plot_dendrogram_k3 <- function(label_y = -0.65) {
  # label_y: vertical position of the cluster labels; adjust if the
  # labels overlap the dendrogram on your device.
  par(mar = c(3.5, 5, 1, 1), xpd = NA)

  plot(hc_pc, labels = FALSE, hang = -1, main = "", xlab = "", sub = "",
       ylab = "Ward.D2 linkage height",
       cex.axis = 1.1, cex.lab = 1.2, lwd = 1.2)

  # Map raw hclust cluster IDs -> final cluster names
  raw_to_final <- tapply(as.character(dat_y1$cluster), dat_y1$cluster_raw,
                         function(x) unique(x)[1])

  # Clusters in left -> right order along the dendrogram
  cluster_ordered   <- dat_y1$cluster_raw[hc_pc$order]
  raw_left_to_right <- unique(cluster_ordered)
  final_left_to_right <- raw_to_final[as.character(raw_left_to_right)]

  cluster_centres <- sapply(raw_left_to_right,
                            function(k) mean(which(cluster_ordered == k)))

  rect.hclust(hc_pc, k = 3,
              border = cluster_colors[final_left_to_right])

  text(x = cluster_centres, y = label_y,
       labels = final_left_to_right,
       col = cluster_colors[final_left_to_right],
       cex = 1.05, font = 2)
}

pdf(file.path(dir_fig, "Supplementary_Figure_S2_dendrogram.pdf"),
    width = 8, height = 5)
plot_dendrogram_k3()
dev.off()

png(file.path(dir_fig, "Supplementary_Figure_S2_dendrogram.png"),
    width = 8, height = 5, units = "in", res = 600)
plot_dendrogram_k3()
dev.off()

plot_dendrogram_k3()


