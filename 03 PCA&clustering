# ============================================================
# 03_clustering_fig4.R
# Year 1 immune phenotype analysis
#
# Workflow:
#   Y1 five biomarkers (children with Y2 outcome COVID / No Events)
#   -> complete, positive values -> log10 -> standardise
#   -> PCA -> keep PC1-PC3 -> Ward.D2 hierarchical clustering, K = 3
#   -> characterise clusters -> compare subsequent Y2 infection
#
# Outputs
#   Figure 4
#   Supplementary Figure S1: PCA (3D + 2D projections)
#   Supplementary Figure S2: dendrogram
#   Supplementary Figure S3: Year 1 biomarkers by cluster
#   data/processed/cluster_assignments.rds  (used by 04_*.R)
#
# Requires: data/processed/dat_clean.rds  (from 01_clean_data.R)
# ============================================================

source(here::here("R", "00_setup.R"))

dat <- readRDS(file.path(dir_processed, "dat_clean.rds"))

keys    <- biomarker_info$key
y1_cols <- bm_col(keys, 1)


# ---- 1. Analysis cohort ------------------------------------------
# The Y2 outcome restriction is applied BEFORE PCA / clustering.
dat_y1 <- dat %>%
  filter(event_y2 %in% c("COVID", "No Events")) %>%
  filter(if_all(all_of(y1_cols), ~ !is.na(.x) & .x > 0)) %>%
  select(subject_id, event_y2, all_of(y1_cols)) %>%
  rename_with(~ sub("_y1$", "", .x), all_of(y1_cols))

cat("\nFinal Y1 analysis cohort: N =", nrow(dat_y1), "\n")
print(table(dat_y1$event_y2))


# ---- 2. log10, standardise, PCA ----------------------------------
x_log    <- log10(as.matrix(dat_y1[, keys]))
x_scaled <- scale(x_log)

pca_y1 <- prcomp(x_scaled, center = FALSE, scale. = FALSE)

variance_percent   <- 100 * pca_y1$sdev^2 / sum(pca_y1$sdev^2)
cumulative_percent <- cumsum(variance_percent)
cat("\nVariance explained (%):", round(variance_percent, 1), "\n")
cat("PC1-PC3 cumulative variance:", round(cumulative_percent[3], 2), "%\n")

pc123 <- pca_y1$x[, 1:3, drop = FALSE]


# ---- 3. Ward.D2 hierarchical clustering, K = 3 --------------------
hc_pc <- hclust(dist(pc123, method = "euclidean"), method = "ward.D2")
cluster_raw <- cutree(hc_pc, k = 3)


# ---- 4. Name clusters by rule (not by arbitrary hclust order) -----
# Cluster 1 = broad low response   (lowest mean of the 4 humoral markers)
# Cluster 2 = cellular / IFN-g     (of the rest, highest IFN-g relative
#                                   to the humoral mean)
# Cluster 3 = broad high response  (remaining cluster)
raw_cluster_profiles <- as.data.frame(x_scaled) %>%
  mutate(cluster_raw = cluster_raw) %>%
  group_by(cluster_raw) %>%
  summarise(across(all_of(keys), mean), .groups = "drop") %>%
  mutate(
    humoral_mean      = (igg + iga + nab + mbc) / 4,
    cellular_relative = ifng - humoral_mean
  )

raw_low <- raw_cluster_profiles %>%
  arrange(humoral_mean) %>% slice(1) %>% pull(cluster_raw)

raw_cellular <- raw_cluster_profiles %>%
  filter(cluster_raw != raw_low) %>%
  arrange(desc(cellular_relative)) %>% slice(1) %>% pull(cluster_raw)

raw_high <- setdiff(unique(cluster_raw), c(raw_low, raw_cellular))
stopifnot(length(raw_high) == 1)

dat_y1 <- dat_y1 %>%
  mutate(
    cluster_raw = cluster_raw,
    cluster = factor(
      case_when(
        cluster_raw == raw_low      ~ "Cluster 1",
        cluster_raw == raw_cellular ~ "Cluster 2",
        cluster_raw == raw_high     ~ "Cluster 3"
      ),
      levels = c("Cluster 1", "Cluster 2", "Cluster 3")
    )
  )

cat("\nCluster sizes:\n")
print(table(dat_y1$cluster))

# Save assignments for downstream scripts
saveRDS(
  bind_cols(
    dat_y1 %>% select(subject_id, event_y2, cluster),
    as.data.frame(pc123)
  ),
  file.path(dir_processed, "cluster_assignments.rds")
)


# ############################################################
# FIGURE 4
# ############################################################

# ---- Panel A: standardised profile --------------------------------
profile_long <- as.data.frame(x_scaled) %>%
  mutate(subject_id = dat_y1$subject_id, cluster = dat_y1$cluster) %>%
  pivot_longer(all_of(keys), names_to = "biomarker", values_to = "z_value") %>%
  mutate(biomarker = factor(biomarker, levels = keys,
                            labels = biomarker_info$short_label))

profile_means <- profile_long %>%
  group_by(cluster, biomarker) %>%
  summarise(mean_z = mean(z_value), .groups = "drop")

write.csv(profile_means, file.path(dir_tab, "fig4_cluster_profile_means.csv"),
          row.names = FALSE)

p_profile <- ggplot() +
  geom_hline(yintercept = 0, linetype = "dashed",
             linewidth = 0.6, color = "grey55") +
  geom_point(data = profile_long,
             aes(x = biomarker, y = z_value, color = cluster),
             alpha = 0.18, size = 1.9,
             position = position_jitter(width = 0.06, height = 0)) +
  geom_point(data = profile_means,
             aes(x = biomarker, y = mean_z, color = cluster),
             size = 5.5) +
  scale_color_manual(values = cluster_colors) +
  labs(title = "A", x = NULL,
       y = expression("Standardized log"[10] * " biomarker level"),
       color = NULL) +
  theme_classic(base_size = 13) +
  theme(
    plot.title   = element_text(face = "bold", size = 15),
    legend.position = "top",
    legend.text  = element_text(size = 11),
    axis.text.x  = element_text(size = 11, angle = 25, hjust = 1),
    axis.text.y  = element_text(size = 11),
    axis.title.y = element_text(size = 12, margin = margin(r = 8))
  )


# ---- Subsequent Y2 infection by cluster ----------------------------
infection_summary <- dat_y1 %>%
  group_by(cluster) %>%
  summarise(
    total    = n(),
    infected = sum(event_y2 == "COVID"),
    no_event = sum(event_y2 == "No Events"),
    infection_percent = 100 * infected / total,
    .groups = "drop"
  ) %>%
  mutate(label = paste0(infected, "/", total, "\n",
                        sprintf("%.1f%%", infection_percent)))

cat("\nY2 infection by cluster:\n")
print(infection_summary)

infection_table <- table(dat_y1$cluster, dat_y1$event_y2)
print(infection_table)

fisher_infection <- fisher.test(infection_table)
cat("\nFisher's exact test (cluster x subsequent infection): p =",
    signif(fisher_infection$p.value, 4), "\n")

write.csv(
  infection_summary %>% mutate(fisher_p = fisher_infection$p.value),
  file.path(dir_tab, "fig4_infection_by_cluster.csv"),
  row.names = FALSE
)


# ---- Panel B: infection by cluster ----------------------------------
p_infection <- ggplot(infection_summary,
                      aes(x = cluster, y = infection_percent, fill = cluster)) +
  geom_col(width = 0.60, alpha = 0.92) +
  geom_text(aes(label = label), color = "black", size = 4,
            vjust = -0.45, lineheight = 0.9) +
  scale_fill_manual(values = cluster_colors) +
  scale_y_continuous(
    limits = c(0, 105),
    breaks = seq(0, 100, 20),
    labels = function(x) paste0(x, "%"),
    expand = expansion(mult = c(0, 0.02))
  ) +
  labs(title = "B", x = NULL, y = "Subsequent SARS-CoV-2 infection") +
  theme_classic(base_size = 13) +
  theme(
    plot.title   = element_text(face = "bold", size = 15),
    legend.position = "none",
    axis.text.x  = element_text(size = 11),
    axis.text.y  = element_text(size = 11),
    axis.title.y = element_text(size = 12, margin = margin(r = 8))
  )

figure4 <- (p_profile | plot_spacer() | p_infection) +
  plot_layout(widths = c(2.1, 0.06, 1))

print(figure4)
save_figure(figure4, "Figure4", width = 12, height = 5.5)


