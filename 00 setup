# ---- Helpers --------------------------------------------------
# Significance stars from a p-value
sig_stars <- function(p, ns_label = "ns") {
  case_when(
    p < 0.001 ~ "***",
    p < 0.01  ~ "**",
    p < 0.05  ~ "*",
    TRUE      ~ ns_label
  )
}

# Save a ggplot as PDF (vector) and PNG (600 dpi)
save_figure <- function(plot, name, width, height) {
  ggsave(
    file.path(dir_fig, paste0(name, ".pdf")),
    plot = plot, device = cairo_pdf,
    width = width, height = height, units = "in"
  )
  ggsave(
    file.path(dir_fig, paste0(name, ".png")),
    plot = plot, width = width, height = height,
    units = "in", dpi = 600
  )
}
